{
  "manifest_version": 3,
  "name": "GitLab File Path Copy",
  "version": "1.0",
  "description": "Adds a copy button to GitLab merge request diff files",
  "permissions": [
    "clipboardWrite"
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/copy.svg"],
      "matches": ["*://{{GITLAB_DOMAIN}}/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://{{GITLAB_DOMAIN}}/*/merge_requests/*/diffs*"
      ],
      "js": ["src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
